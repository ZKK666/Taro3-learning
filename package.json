{
  "name": "taro-short-video",
  "version": "1.0.0",
  "private": true,
  "description": "小程序版抖音 - Taro 3 + 原生小程序混合开发学习项目",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "scss"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:swan": "taro build --type swan",
    "dev:swan": "npm run build:swan -- --watch",
    "build:alipay": "taro build --type alipay",
    "dev:alipay": "npm run build:alipay -- --watch",
    "build:tt": "taro build --type tt",
    "dev:tt": "npm run build:tt -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "build:rn": "taro build --type rn",
    "dev:rn": "npm run build:rn -- --watch",
    "build:qq": "taro build --type qq",
    "dev:qq": "npm run build:qq -- --watch",
    "build:jd": "taro build --type jd",
    "dev:jd": "npm run build:jd -- --watch",
    "build:quickapp": "taro build --type quickapp",
    "dev:quickapp": "npm run build:quickapp -- --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^7.21.5",
    "@tarojs/components": "3.6.23",
    "@tarojs/helper": "3.6.23",
    "@tarojs/plugin-framework-react": "^3.6.23",
    "@tarojs/plugin-platform-alipay": "3.6.23",
    "@tarojs/plugin-platform-jd": "3.6.23",
    "@tarojs/plugin-platform-qq": "3.6.23",
    "@tarojs/plugin-platform-swan": "3.6.23",
    "@tarojs/plugin-platform-tt": "3.6.23",
    "@tarojs/plugin-platform-weapp": "3.6.23",
    "@tarojs/react": "3.6.23",
    "@tarojs/runtime": "3.6.23",
    "@tarojs/shared": "3.6.23",
    "@tarojs/taro": "3.6.23",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.8.0",
    "@tarojs/cli": "3.6.23",
    "@tarojs/webpack5-runner": "3.6.23",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "babel-preset-taro": "3.6.23",
    "eslint": "^8.12.0",
    "eslint-config-taro": "3.6.23",
    "eslint-plugin-react": "^7.8.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "postcss": "^8.4.18",
    "sass": "^1.69.5",
    "stylelint": "^15.10.1",
    "typescript": "^5.1.0",
    "webpack": "5.78.0"
  }
}
