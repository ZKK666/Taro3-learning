/* 消息中心样式 */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #161823;
}

/* 消息类型入口 */
.message-types {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 20rpx;
  background-color: #1e1e2e;
  margin-bottom: 20rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  width: 25%;
}

.type-icon-wrapper {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-icon {
  font-size: 48rpx;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  background-color: #fe2c55;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 500;
}

.type-name {
  font-size: 26rpx;
  color: #fff;
}

.type-preview {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 最近消息 */
.recent-section {
  background-color: #1e1e2e;
}

.section-header {
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
}

.message-list {
  padding: 0 30rpx;
}

.message-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  position: relative;
}

.message-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.message-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
}

.message-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

.message-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.unread-dot {
  position: absolute;
  left: 70rpx;
  top: 30rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #fe2c55;
  border-radius: 50%;
}

/* 空状态 */
.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
}
