/* 登录页面样式 */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #000;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  padding-bottom: 100rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
}

.app-name {
  font-size: 56rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
}

.slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 登录按钮区域 */
.login-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border-radius: 48rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 500;
}

.login-btn::after {
  border: none;
}

.wechat-btn {
  background-color: #07c160;
  color: #fff;
}

.phone-btn {
  background-color: #fe2c55;
  color: #fff;
}

.btn-icon {
  font-size: 36rpx;
}

.btn-text {
  font-size: 32rpx;
}

/* 其他登录方式 */
.other-login {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
}

.other-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 30rpx;
}

.other-icons {
  display: flex;
  gap: 60rpx;
}

.other-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.other-icon text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* 协议 */
.agreement-section {
  position: absolute;
  bottom: 200rpx;
  left: 60rpx;
  right: 60rpx;
}

.checkbox-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  background-color: #fe2c55;
  border-color: #fe2c55;
}

.checkbox text {
  font-size: 20rpx;
  color: #fff;
}

.agreement-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.link {
  color: #fe2c55;
}

/* 游客模式 */
.guest-section {
  position: absolute;
  bottom: 120rpx;
}

.guest-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
}
